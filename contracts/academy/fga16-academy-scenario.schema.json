{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://angelic-articles.com/fga/schemas/fga16-academy-scenario.schema.json",
  "title": "Fraud Graph Arena Academy scenario",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "curriculum_version",
    "scenarios"
  ],
  "properties": {
    "schema_version": {"const": "fga16-academy-scenario-v1"},
    "curriculum_version": {"type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"},
    "scenarios": {
      "type": "array",
      "minItems": 9,
      "uniqueItems": true,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "scenario_id",
          "scenario_version",
          "title",
          "mechanic",
          "learning_objective",
          "path_id",
          "case_id",
          "seed",
          "visible_evidence",
          "actions",
          "expected_transitions",
          "tutorial_guidance",
          "resource_profile",
          "execution_mode",
          "protected_expected_outcome"
        ],
        "properties": {
          "scenario_id": {"type": "string", "pattern": "^academy-[a-z0-9-]+$"},
          "scenario_version": {"type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"},
          "title": {"type": "string", "minLength": 1, "maxLength": 160},
          "mechanic": {"enum": ["NODE_SELECTION", "EDGE_INSPECTION", "ENTITY_RESOLUTION", "GRAPH_TRAVERSAL", "RESOURCE_SPENDING", "CONTRADICTORY_EVIDENCE", "CORRECT_ACCUSATION", "INCORRECT_ACCUSATION", "COMPLETE_GAME_LOOP"]},
          "learning_objective": {"type": "string", "minLength": 1, "maxLength": 500},
          "path_id": {"const": "DETECTIVE_ACADEMY"},
          "case_id": {"type": "string", "pattern": "^[A-Z][A-Z0-9_]{2,63}$"},
          "seed": {"type": "string", "pattern": "^fga16-[a-z0-9-]+$"},
          "visible_evidence": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1, "maxLength": 240}},
          "actions": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["action_id", "label", "kind"],
              "properties": {
                "action_id": {"type": "string", "pattern": "^[A-Z][A-Z0-9_]{2,63}$"},
                "label": {"type": "string", "minLength": 1, "maxLength": 160},
                "kind": {"type": "string", "pattern": "^[A-Z][A-Z0-9_]{2,63}$"}
              }
            }
          },
          "expected_transitions": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["from", "action_id", "to"],
              "properties": {
                "from": {"type": "string", "pattern": "^[A-Z][A-Z0-9_]{2,63}$"},
                "action_id": {"type": "string", "pattern": "^[A-Z][A-Z0-9_]{2,63}$"},
                "to": {"type": "string", "pattern": "^[A-Z][A-Z0-9_]{2,63}$"}
              }
            }
          },
          "tutorial_guidance": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1, "maxLength": 500}},
          "resource_profile": {
            "type": "object",
            "additionalProperties": false,
            "required": ["starting_credits", "credits_spent"],
            "properties": {
              "starting_credits": {"type": "integer", "minimum": 0},
              "credits_spent": {"type": "integer", "minimum": 0}
            }
          },
          "execution_mode": {"enum": ["COMPONENT_MOCK", "API_CONTRACT", "COMPLETE_LOOP"]},
          "protected_expected_outcome": {
            "type": "object",
            "additionalProperties": false,
            "required": ["final_state", "golden_result_id", "assertion_ids"],
            "properties": {
              "final_state": {"type": "string", "pattern": "^[A-Z][A-Z0-9_]{2,63}$"},
              "golden_result_id": {"type": "string", "pattern": "^golden-academy-[a-z0-9-]+$"},
              "assertion_ids": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "pattern": "^FGA16-[A-Z0-9-]+$"}}
            }
          }
        }
      }
    }
  }
}
