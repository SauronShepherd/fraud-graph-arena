{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": ["ES2022", "DOM"],
    "strict": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "allowSyntheticDefaultImports": true,
    "typeRoots": ["../apps/web/node_modules/@types"],
    "baseUrl": ".",
    "paths": {
      "cytoscape": ["../apps/web/node_modules/cytoscape"],
      "d3": ["../apps/web/node_modules/@types/d3/index.d.ts"],
      "graphology": ["../apps/web/node_modules/graphology"],
      "sigma": ["../apps/web/node_modules/sigma"],
      "@xyflow/react": ["../apps/web/node_modules/@xyflow/react"]
    }
  },
  "include": ["candidate-contract.ts", "harness.ts", "adapters/**/*.ts", "benchmark-runner.ts", "vite-env.d.ts"]
}
