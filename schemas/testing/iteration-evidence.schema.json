{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://fraud-graph-arena.local/schemas/testing/iteration-evidence.schema.json",
  "title": "Fraud Graph Arena iteration evidence bundle",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "evidence_id",
    "iteration_id",
    "generated_at",
    "source_commit",
    "status",
    "closure_eligible",
    "environment",
    "commands",
    "source_artifacts",
    "gates",
    "tests",
    "exceptions",
    "known_gaps",
    "approvals",
    "bundle_digest"
  ],
  "properties": {
    "evidence_id": {
      "type": "string",
      "pattern": "^EVID-I[0-9]{2}-[A-Z0-9-]+$"
    },
    "iteration_id": {
      "type": "string",
      "pattern": "^I[0-9]{2}$"
    },
    "generated_at": {
      "type": "string",
      "format": "date-time"
    },
    "source_commit": {
      "type": "string",
      "minLength": 7
    },
    "status": {
      "enum": [
        "passing",
        "failing",
        "blocked"
      ]
    },
    "closure_eligible": {
      "type": "boolean"
    },
    "environment": {
      "type": "object",
      "additionalProperties": {
        "type": [
          "string",
          "number",
          "boolean"
        ]
      },
      "required": [
        "os",
        "python",
        "clean_checkout"
      ]
    },
    "commands": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string"
      }
    },
    "source_artifacts": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "artifact_id",
          "status"
        ],
        "properties": {
          "artifact_id": {
            "type": "string"
          },
          "status": {
            "enum": [
              "verified",
              "missing",
              "superseded"
            ]
          },
          "path": {
            "type": "string"
          },
          "sha256": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          }
        }
      }
    },
    "gates": {
      "type": "array",
      "minItems": 15,
      "maxItems": 15,
      "items": {
        "$ref": "#/$defs/gate"
      }
    },
    "tests": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/test"
      }
    },
    "exceptions": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "critical",
          "reason",
          "owner",
          "expires"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "critical": {
            "type": "boolean"
          },
          "reason": {
            "type": "string"
          },
          "owner": {
            "type": "string"
          },
          "expires": {
            "type": "string",
            "format": "date"
          }
        }
      }
    },
    "known_gaps": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "severity",
          "description",
          "owner",
          "blocks_closure"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "severity": {
            "enum": [
              "low",
              "medium",
              "high",
              "critical"
            ]
          },
          "description": {
            "type": "string"
          },
          "owner": {
            "type": "string"
          },
          "blocks_closure": {
            "type": "boolean"
          },
          "remediation": {
            "type": "string"
          }
        }
      }
    },
    "approvals": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "role",
          "status"
        ],
        "properties": {
          "role": {
            "type": "string"
          },
          "status": {
            "enum": [
              "approved",
              "pending",
              "rejected"
            ]
          },
          "name": {
            "type": "string"
          },
          "date": {
            "type": "string",
            "format": "date"
          }
        }
      }
    },
    "bundle_digest": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    }
  },
  "$defs": {
    "gate": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "gate_id",
        "name",
        "status",
        "rationale",
        "evidence"
      ],
      "properties": {
        "gate_id": {
          "type": "string",
          "pattern": "^G(?:0[1-9]|1[0-5])$"
        },
        "name": {
          "type": "string"
        },
        "status": {
          "enum": [
            "pass",
            "fail",
            "blocked",
            "not_applicable"
          ]
        },
        "rationale": {
          "type": "string",
          "minLength": 8
        },
        "evidence": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "test": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "test_id",
        "status",
        "command",
        "result"
      ],
      "properties": {
        "test_id": {
          "type": "string",
          "pattern": "^TEST-[A-Z0-9-]+$"
        },
        "status": {
          "enum": [
            "pass",
            "fail",
            "blocked",
            "not_applicable"
          ]
        },
        "command": {
          "type": "string"
        },
        "result": {
          "type": "string"
        },
        "seed": {
          "type": [
            "string",
            "integer"
          ]
        },
        "duration_ms": {
          "type": "integer",
          "minimum": 0
        },
        "report": {
          "type": "string"
        }
      }
    }
  }
}
