{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": ["model_version", "physical_table_count", "tables"],
  "properties": {
    "model_version": {"const": "1.0.0"},
    "physical_table_count": {"const": 32},
    "tables": {
      "type": "object", "minProperties": 32, "maxProperties": 32,
      "additionalProperties": {"$ref": "#/$defs/table"}
    }
  },
  "$defs": {
    "table": {
      "type": "object", "additionalProperties": false,
      "required": ["layer", "primary_key", "columns"],
      "properties": {
        "layer": {"enum": ["config", "authoring", "analytics", "published", "genie", "truth", "validation"]},
        "primary_key": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
        "columns": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"$ref": "#/$defs/column"}},
        "references": {"type": "array", "items": {"$ref": "#/$defs/reference"}}
      }
    },
    "column": {
      "type": "object", "additionalProperties": false,
      "required": ["name", "sql_type", "nullable"],
      "properties": {
        "name": {"type": "string", "pattern": "^[a-z][a-z0-9_]*$"},
        "sql_type": {"enum": ["STRING", "INT", "BIGINT", "BOOLEAN", "DATE", "TIMESTAMP", "DECIMAL(18,8)", "DECIMAL(38,10)", "JSON"]},
        "nullable": {"type": "boolean"},
        "description": {"type": "string"}
      }
    },
    "reference": {
      "type": "object",
      "additionalProperties": false,
      "required": ["from", "column", "to", "target_column"],
      "properties": {
        "from": {"type": "string", "minLength": 1},
        "column": {"type": "string", "pattern": "^[a-z][a-z0-9_]*$"},
        "to": {"type": "string", "minLength": 1},
        "target_column": {"type": "string", "pattern": "^[a-z][a-z0-9_]*$"}
      }
    }
  }
}
