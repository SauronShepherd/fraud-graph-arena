{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": ["model", "version", "tables", "layers"],
  "properties": {
    "model": {"const": "FGA Canonical Case Data Model"},
    "version": {"const": "1.0.0"},
    "tables": {
      "type": "array", "minItems": 32, "maxItems": 32, "uniqueItems": true,
      "items": {"type": "string", "enum": ["config/cases.csv","config/case_profiles.csv","config/case_initial_items.csv","config/ui_contracts.csv","config/registries.csv","config/reveal_steps.csv","config/genie_benchmarks.csv","authoring/records.csv","authoring/record_attributes.csv","authoring/relationships.csv","analytics/entity_resolution_candidates.csv","analytics/exact_matches.csv","analytics/tool_fixtures.csv","published/records.csv","published/relationships.csv","published/entity_resolution_candidates.csv","published/exact_matches.csv","genie/records.csv","genie/record_attributes.csv","genie/relationships.csv","truth/entities.csv","truth/claims.csv","truth/evidence_requirements.csv","truth/evidence_routes.csv","truth/allowed_alternatives.csv","truth/forbidden_conclusions.csv","truth/scoring_rules.csv","truth/ending_rules.csv","truth/test_scenarios.csv","truth/assertions.csv","validation/checks.csv","validation/metrics.csv"]}
    },
    "layers": {"type": "object", "additionalProperties": {"type": "string"}, "minProperties": 7, "maxProperties": 7}
  }
}
