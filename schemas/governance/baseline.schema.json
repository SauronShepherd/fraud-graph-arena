{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://fraud-graph-arena.local/schemas/governance/baseline.schema.json",
  "title": "Fraud Graph Arena normative baseline registry",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "baseline_id",
    "version",
    "date",
    "status",
    "precedence",
    "artifacts",
    "closure_requirements"
  ],
  "properties": {
    "baseline_id": {
      "type": "string",
      "pattern": "^FGA-BASELINE-[0-9]+\\.[0-9]+-[0-9]{8}$"
    },
    "version": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+$"
    },
    "date": {
      "type": "string",
      "format": "date"
    },
    "status": {
      "enum": [
        "active",
        "blocked",
        "superseded"
      ]
    },
    "precedence": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "rank",
          "authority",
          "rule"
        ],
        "properties": {
          "rank": {
            "type": "integer",
            "minimum": 1
          },
          "authority": {
            "type": "string",
            "minLength": 3
          },
          "rule": {
            "type": "string",
            "minLength": 10
          }
        }
      }
    },
    "artifacts": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/artifact"
      }
    },
    "closure_requirements": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "all_required_available",
        "all_available_digests_verified",
        "unresolved_required_artifact_ids"
      ],
      "properties": {
        "all_required_available": {
          "type": "boolean"
        },
        "all_available_digests_verified": {
          "type": "boolean"
        },
        "unresolved_required_artifact_ids": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "uniqueItems": true
        }
      }
    }
  },
  "$defs": {
    "artifact": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "artifact_id",
        "title",
        "kind",
        "authority_rank",
        "version",
        "date",
        "availability",
        "required_for_closure"
      ],
      "properties": {
        "artifact_id": {
          "type": "string",
          "minLength": 5
        },
        "title": {
          "type": "string",
          "minLength": 3
        },
        "kind": {
          "enum": [
            "normative_pair",
            "modular_specification",
            "architecture_specification",
            "module_specification",
            "build_plan",
            "source_archive",
            "integrity_manifest"
          ]
        },
        "authority_rank": {
          "type": "integer",
          "minimum": 1
        },
        "version": {
          "type": "string",
          "minLength": 1
        },
        "date": {
          "type": "string",
          "format": "date"
        },
        "availability": {
          "enum": [
            "available",
            "external_missing",
            "superseded"
          ]
        },
        "path": {
          "type": "string",
          "minLength": 1
        },
        "sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "external_reference": {
          "type": "string",
          "minLength": 3
        },
        "required_for_closure": {
          "type": "boolean"
        },
        "supersedes": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "uniqueItems": true
        },
        "notes": {
          "type": "string"
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "availability": {
                "const": "available"
              }
            }
          },
          "then": {
            "required": [
              "path",
              "sha256"
            ]
          }
        },
        {
          "if": {
            "properties": {
              "availability": {
                "const": "external_missing"
              }
            }
          },
          "then": {
            "required": [
              "external_reference"
            ],
            "not": {
              "anyOf": [
                {
                  "required": [
                    "path"
                  ]
                },
                {
                  "required": [
                    "sha256"
                  ]
                }
              ]
            }
          }
        }
      ]
    }
  }
}
