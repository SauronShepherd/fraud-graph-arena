# Operational wiring only. Gameplay rules do not belong here.
FGA_ENVIRONMENT=development
FGA_RUNTIME_ROLE=WEB
FGA_ROUND_REPOSITORY=sqlite
FGA_SQLITE_PATH=.fga/fga.sqlite3
FGA_ALLOWED_ORIGINS=["http://localhost:5173"]
FGA_LOG_LEVEL=INFO
FGA_FRONTEND_DIST=apps/web/dist

# Compose interpolation values for the local-build workflow.
FGA_LOCAL_IMAGE=fraud-graph-arena:local
FGA_WEB_PORT=8000
FGA_SOURCE_REVISION=working-tree

# FGA_IMAGE is intentionally not required here. Set it only when selecting the
# published-image override: FGA_IMAGE=registry.example/fga@sha256:...
